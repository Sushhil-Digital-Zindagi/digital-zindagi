service : {
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  _initializeAccessControl: () -> ();
  activateStripePremium: (plan: PremiumPlan, stripeSubscriptionId: text) ->
   (variant {
      err: text;
      ok;
    });
  addBanner: (title: text, subtitle: text, imageUrl: text, linkUrl: text,
   displayOrder: nat) -> (nat);
  addCategory: (name: text, emoji: text, color: text) -> (nat);
  addChatGroupMembers: (conversationId: nat, memberIds: vec principal) ->
   (bool);
  addChatPersonalShortcut: (trigger: text, content: text, category: text) ->
   (variant {
      err: text;
      ok: nat;
    });
  addChatVaultItem: (mediaUrl: text, title: text, isViewOnce: bool,
   expiresAt: opt int) -> (variant {
                             err: text;
                             ok: nat;
                           });
  addCoin: (adminToken: opt text, name: text, symbol: text, coinGeckoId:
   text, logoUrl: text) -> (variant {
                              err: text;
                              ok: CryptoCoin;
                            });
  addCustomCode: (name: text, code: text, btnLabel: text, icon: text,
   placement: text, title: text, subtitle1: text, subtitle2: text, alignment:
   text, layoutStyle: text) -> (nat);
  addCustomSection: (name: text, heading: text, placement: text, buttons:
   text) -> (nat);
  addJob: (title: text, department: text, location: text, lastDate: text,
   applyLink: text, category: text) -> (nat);
  /// Add a manager by mobile number — admin only.
  /// Managers have restricted access (News, Jobs, Videos).
  addManager: (mobile: text) -> (bool);
  addNews: (title: text, summary: text, imageUrl: text, link: text, category:
   text) -> (nat);
  addScrapRate: (itemName: text, ratePerKg: float64, ratePerGram: float64) ->
   (nat);
  addServiceRate: (userId: nat, newRate: ServiceRate) -> ();
  addShopPhoto: (userId: nat, blobId: text) -> ();
  /// Add a customer under the calling provider's shop.
  /// shopId is derived from msg.caller — never accepted from the client.
  addUdhaarCustomer: (name: text, mobile: text, address: text) ->
   (variant {
      err: text;
      ok: UdhaarCustomer;
    });
  /// Add a transaction. shopId is derived from caller; customerId must belong to caller.
  addUdhaarTransaction: (customerId: text, amount: float64, transactionType:
   text, date: text, note: text) ->
   (variant {
      err: text;
      ok: UdhaarTransaction;
    });
  addVideo: (title: text, videoUrl: text, thumbnailUrl: text, platform: 
   text, category: text) -> (nat);
  /// Adjust wallet balance for a user by userId (Nat) — admin only.
  /// Alias so both adminAdjustWallet and adjustWalletBalance work.
  adjustWalletBalance: (userId: nat, amount: float64, isAdd: bool, note:
   text) -> (variant {
               err: text;
               ok;
             });
  adminAddChatShortcut: (trigger: text, content: text, category: text) ->
   (variant {
      err: text;
      ok: nat;
    });
  adminAddNewsItem: (title: text, content: text, imageUrl: opt text) ->
   (variant {
      err: text;
      ok: nat;
    });
  /// Directly add or deduct balance for any user — admin only.
  adminAdjustWallet: (userId: nat, amount: float64, isAdd: bool, _note:
   text) -> (bool);
  /// Adjust (add or deduct) a user's wallet balance and log the action — admin only.
  /// Returns the new balance as Int on success.
  adminAdjustWalletBalance: (adminToken: opt text, userId: text, amount: 
   int, action: text, note: text) -> (variant {
                                        err: text;
                                        ok: int;
                                      });
  adminApproveCryptoWithdrawal: (adminToken: opt text, withdrawalId: 
   text, adminNote: opt text) -> (variant {
                                    err: text;
                                    ok;
                                  });
  adminApproveDeposit: (adminToken: opt text, txId: text) ->
   (variant {
      err: text;
      ok;
    });
  adminApproveUpiPremium: (requestId: nat) -> (variant {
                                                 err: text;
                                                 ok;
                                               });
  /// Approve a UPI unlock request — admin only.
  adminApproveUpiUnlock: (paymentId: nat) -> (variant {
                                                err: text;
                                                ok;
                                              });
  /// Manually assign or revoke a subscription for a user — admin only.
  adminAssignSubscription: (adminToken: opt text, userId: text, durationDays:
   nat, action: text) -> (variant {
                            err: text;
                            ok;
                          });
  adminBroadcastChatMessage: (content: text) -> (bool);
  adminDeleteChatShortcut: (id: nat) -> (bool);
  adminDeleteNewsItem: (id: nat) -> (variant {
                                       err: text;
                                       ok;
                                     });
  adminGetAllCryptoUsers: (adminToken: opt text) ->
   (variant {
      err: text;
      ok: vec CryptoWallet;
    });
  adminGetAllTickets: (adminToken: opt text) ->
   (variant {
      err: text;
      ok: vec SupportTicket;
    });
  adminGetAllWithdrawals: (adminToken: opt text) ->
   (variant {
      err: text;
      ok: vec CryptoWithdrawal;
    });
  adminGetChatStats: () -> (ChatStats) query;
  adminGetCryptoStats: (adminToken: opt text) ->
   (variant {
      err: text;
      ok:
       record {
         totalBalance: float64;
         totalCommissions: float64;
         totalUsers: nat;
         totalVolume: float64;
       };
    });
  adminGetUpiPremiumRequests: () -> (vec UpiPaymentRequest) query;
  /// Return all pending UPI unlock requests — admin only.
  /// Returns empty array for non-admin callers (never traps).
  adminGetUpiUnlockRequests: () -> (vec LockedMessagePayment) query;
  /// List all Offer Portal users — admin only.
  /// Accepts adminToken for email+password auth flow (anonymous principal friendly).
  /// Returns #ok([users]) for admin, #err("Unauthorized") for non-admin — never traps.
  adminListOfferUsers: (adminToken: opt text) ->
   (variant {
      err: text;
      ok: vec OfferUser;
    });
  /// List all pending withdrawal requests — admin only.
  /// Accepts adminToken for email+password auth flow.
  /// Returns #ok([withdrawals]) for admin, #err("Unauthorized") for non-admin — never traps.
  adminListPendingWithdrawals: (adminToken: opt text) ->
   (variant {
      err: text;
      ok: vec OfferWithdrawal;
    });
  adminRejectCryptoWithdrawal: (adminToken: opt text, withdrawalId: text,
   adminNote: opt text) -> (variant {
                              err: text;
                              ok;
                            });
  adminRejectUpiPremium: (requestId: nat) -> (variant {
                                                err: text;
                                                ok;
                                              });
  /// Reject a UPI unlock request — admin only.
  adminRejectUpiUnlock: (paymentId: nat) -> (variant {
                                               err: text;
                                               ok;
                                             });
  adminResetMpin: (adminToken: opt text, userId: text) ->
   (variant {
      err: text;
      ok;
    });
  /// Admin-authenticated direct password reset for an Offer Portal user (no OTP).
  /// callerEmail and callerPasswordHash must match the admin credentials.
  adminResetOfferPassword: (callerEmail: text, callerPasswordHash: text,
   targetEmail: text, newPasswordHash: text) ->
   (variant {
      err: text;
      ok: text;
    });
  /// Resolve a withdrawal request (approve/reject/paid) — admin only.
  /// Accepts adminToken for email+password auth flow.
  /// Returns #ok(true) on success, #err("Unauthorized") for non-admin — never traps.
  adminResolveWithdrawal: (adminToken: opt text, id: nat, newStatus:
   variant {
     approved;
     paid;
     rejected;
   }, adminNote: opt text) -> (variant {
                                 err: text;
                                 ok: bool;
                               });
