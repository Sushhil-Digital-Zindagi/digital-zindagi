  setChatGhostMode: (enabled: bool) -> (bool);
  setChatStudyMode: (enabled: bool, selectedChats: vec nat) -> (bool);
  /// Create or update a locked feature — admin only.
  setLockedFeature: (featureName: text, cpaOfferLink: text, secretKey:
   text) -> (variant {
               err: text;
               ok: text;
             });
  setMpin: (userId: text, mpin: text) -> (variant {
                                            err: text;
                                            ok;
                                          });
  /// Updates the payment configuration (admin only).
  setPaymentConfig: (config: PaymentConfig) -> (bool);
  setPlanType: (userId: nat, planType: PlanType) -> ();
  /// Enable or disable the recharge service — admin only.
  setRechargeServiceEnabled: (enabled: bool) -> (bool);
  submitUpiPremiumRequest: (plan: PremiumPlan, upiTxnRef: text, amount:
   nat) -> (variant {
              err: text;
              ok: nat;
            });
  /// Summarize last 50 messages or last 24h messages for a conversation.
  /// Uses OpenAI via HTTP outcall — API key configured in Chat Admin Settings.
  summarizeChatMessages: (conversationId: nat, mode:
   variant {
     last24h;
     last50;
   }) -> (variant {
            err: text;
            ok: text;
          });
  toggleCustomSection: (id: nat, enabled: bool) -> (bool);
  unlockMessage: (messageId: nat, attempt: text) -> (variant {
                                                       err: text;
                                                       ok;
                                                     });
  updateAdminConfig: (newConfig: AdminConfig) -> ();
  /// Replace ALL admin settings in one atomic call — admin only.
  /// All existing field values are overwritten with the supplied record.
  /// Empty strings for Cloudinary/CPAGrip fields preserve the existing defaults.
  updateAdminSettings: (adminToken: opt text, settings:
   AdminSettingsExtended) -> (bool);
  /// Update AdMob configuration — admin only.
  updateAdmobConfig: (appId: text, bannerUnitId: text, interstitialId: 
   text, ludoBannerId: text, ludoInterstitialId: text, rewardedUnitId:
   text) -> (bool);
  updateAppSettings: (adminToken: opt text, json: text) ->
   (variant {
      err: text;
      ok;
    });
  updateCategory: (id: nat, name: text, emoji: text, color: text, enabled:
   bool) -> (bool);
  updateChatAdminSettings: (settings: ChatAdminSettings) -> (bool);
  updateChatGroupInfo: (conversationId: nat, name: opt text, photoUrl:
   opt text) -> (bool);
  updateChatNote: (id: nat, title: opt text, content: opt text, subject:
   opt text) -> (bool);
  /// Update Cloudinary credentials — admin only.
  /// Empty strings preserve existing defaults.
  updateCloudinaryConfig: (cloudName: text, apiKey: text, apiSecret: 
   text) -> (variant {
               err: text;
               ok;
             });
  updateCoin: (adminToken: opt text, id: text, isListed: bool) ->
   (variant {
      err: text;
      ok: CryptoCoin;
    });
  /// Update commission config — admin only.
  /// Validates: retailerPct + adminPct must equal globalPct.
  updateCommissionConfig: (globalPct: float64, retailerPct: float64,
   adminPct: float64) -> (bool);
  /// Save the CPAGrip API key in canister state — admin only.
  /// Also mirrors the key into the live offerPortalConfig so it takes effect immediately.
  updateCpagripApiKey: (apiKey: text) -> (bool);
  /// Save CPAGrip Webhook Secret Key and Offer Wall Name — admin only.
  /// Both fields are persisted in separate stable vars so they survive reloads.
  /// Empty strings are ignored — existing values are preserved.
  updateCpagripSettings: (adminToken: opt text, apiKey: text, webhookSecret:
   text, offerWallName: text) -> (bool);
  updateCryptoConfig: (adminToken: opt text, config: CryptoInvestConfig) ->
   (variant {
      err: text;
      ok;
    });
  updateCustomCode: (id: nat, name: text, code: text, btnLabel: text, icon:
   text, placement: text, enabled: bool, title: text, subtitle1: text,
   subtitle2: text, alignment: text, layoutStyle: text) -> (bool);
  updateCustomSection: (id: nat, name: text, heading: text, placement: 
   text, buttons: text, enabled: bool) -> (bool);
  updateJob: (id: nat, title: text, department: text, location: text,
   lastDate: text, applyLink: text, category: text, enabled: bool) -> (
   bool);
  updateListing: (id: nat, title: opt text, description: opt text, price:
   opt nat, city: opt text, photoUrls: opt vec text, whatsappContact:
   opt text) -> (variant {
                   err: text;
                   ok;
                 });
  /// Update only Ludo / Rewards settings — admin only.
  updateLudoSettings: (ludoEnabled: bool, rewardsEnabled: bool, pointsPerAd:
   nat, redemptionRate: nat, minWithdrawal: nat) -> (bool);
  updateMyChatProfile: (displayName: opt text, bio: opt text, city: opt text,
   profilePhotoUrl: opt text) -> (bool);
  updateNews: (id: nat, title: text, summary: text, imageUrl: text, link:
   text, category: text, enabled: bool) -> (bool);
  /// Update Offer Portal config (toggle, offer wall secret, profit split) — admin only.
  /// Also persists cpagripWebhookSecret and cpagripOfferWallName to their stable vars.
  /// Returns #ok(true) on success, #err(reason) if validation fails (e.g. API key too short).
  updateOfferPortalConfig: (adminToken: opt text, isEnabled: bool,
   cpaLeadWebhookSecret: text, cpagripApiKey: text, adminProfitPct: nat,
   userProfitPct: nat, newWebhookSecret: text, newOfferWallName: text) ->
   (variant {
      err: text;
      ok: bool;
    });
  updateOrderStatus: (orderId: nat, status: text) -> ();
  updateProviderProfile: (userId: nat, shopName: text, description: text,
   address: text, category: text) -> ();
  /// Extended updateProviderProfile to include upiId and qrCodeBlobId
  updateProviderProfileFull: (userId: nat, shopName: text, description: 
   text, address: text, category: text, upiId: text, qrCodeBlobId:
   opt text) -> ();
  /// Save recharge API config — admin only.
  updateRechargeApiConfig: (apiUrl: text, apiKey: text, responseParam: 
   text, isActive: bool, autoRefundEnabled: bool) -> (bool);
  /// Update the status of a recharge transaction — admin only.
  /// Auto-refund: if status = "Failed" and autoRefundEnabled, automatically refunds netCost.
  /// Receipt: if status = "Success", generates a digital receipt.
  /// SMS: if smsConfig.isEnabled, sends an alert (fire-and-forget).
  updateRechargeStatus: (txId: nat, status: text) -> (bool);
  /// Update only the 5-tier referral rates — admin only.
  updateReferralRates: (level1Pct: nat, level2Pct: nat, level3Pct: nat,
   level4Pct: float64, level5Pct: float64) -> (bool);
  updateScrapRate: (id: nat, itemName: text, ratePerKg: float64, ratePerGram:
   float64, enabled: bool) -> (bool);
  /// Update SMS config — admin only.
  /// Returns #ok(true) or #err("Unauthorized: Admin only") — never traps.
  updateSmsConfig: (fast2smsApiKey: text, senderId: text, isEnabled: 
   bool) -> (variant {
               err: text;
               ok: bool;
             });
  /// Update SMS config with admin token — admin only (alias for email+password auth).
  /// Returns #ok(true) or #err("Unauthorized: Admin only") — never traps.
  updateSmsConfigWithToken: (adminToken: opt text, fast2smsApiKey: text,
   senderId: text, isEnabled: bool) -> (variant {
                                          err: text;
                                          ok: bool;
                                        });
  updateSubscriptionPricing: (newPricing: SubscriptionPricing) -> ();
  updateTicketStatus: (adminToken: opt text, ticketId: text, status: 
   text) -> (variant {
               err: text;
               ok;
             });
  updateToggle: (adminToken: opt text, toggleName: text, value: bool) -> ();
  /// Update a customer. Caller must own the customer (shopId check).
  updateUdhaarCustomer: (customerId: text, name: text, mobile: text, address:
   text) -> (variant {
               err: text;
               ok: UdhaarCustomer;
             });
  /// Update a transaction. Caller must own the transaction (shopId check).
  updateUdhaarTransaction: (transactionId: text, amount: float64,
   transactionType: text, date: text, note: text) ->
   (variant {
      err: text;
      ok: UdhaarTransaction;
    });
  updateVideo: (id: nat, title: text, videoUrl: text, thumbnailUrl: text,
   platform: text, category: text, enabled: bool) -> (bool);
  uploadPaymentScreenshot: (userId: nat, blobId: text) -> ();
  /// Verify admin email+password credentials and issue a 24-hour session token.
  /// The frontend stores this token and passes it as ?adminToken to admin methods.
  /// Returns #ok(token) on success, #err(reason) on failure — never traps.
  verifyAdminCredentials: (email: text, password: text) ->
   (variant {
      err: text;
      ok: text;
    });
  verifyAdminPin: (pinHash: text) -> (bool) query;
  /// Verify a Stripe PaymentIntent and unlock the message if payment succeeded.
  verifyStripeUnlock: (messageId: nat, paymentIntentId: text) ->
   (variant {
      err: text;
      ok;
    });
  /// User-facing: verify a plain-text unlock key for a named feature.
  verifyUnlockKey: (featureName: text, userKey: text) -> (VerifyKeyResult);
  viewChatStory: (storyId: nat) -> (bool);
  viewChatVaultItem: (id: nat) -> (opt VaultItem);
}
